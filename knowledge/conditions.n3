@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix bio:   <https://qualia.anatomy.example/ontology/bio#> .
@prefix impact: <https://qualia.anatomy.example/ontology/impact#> .
@prefix organ: <https://qualia.anatomy.example/ontology/organ#> .

# =============================================
# BioStatus / Impact Ontology - Conditions (N3)
# Version: 0.2 - Expanded set (~42 conditions)
# Written in N3 for N3Logic + SHACL compatibility
# =============================================

bio:Condition a owl:Class ;
    rdfs:label "Health Condition" ;
    rdfs:comment "A diagnosable health condition with potential systemic and organ-level impacts." .

impact:Impacts a owl:ObjectProperty ;
    rdfs:label "impacts" ;
    rdfs:domain bio:Condition ;
    rdfs:range organ:AnatomicalStructure .

impact:hasPrimaryImpactSystem a owl:ObjectProperty ;
    rdfs:label "has primary impact system" ;
    rdfs:domain bio:Condition ;
    rdfs:range organ:OrganSystem .

# =============================================
# Organ Systems
# =============================================

organ:OrganSystem a owl:Class ; rdfs:label "Organ System" .
organ:CardiovascularSystem a organ:OrganSystem ; rdfs:label "Cardiovascular System" .
organ:RenalSystem a organ:OrganSystem ; rdfs:label "Renal System" .
organ:MetabolicSystem a organ:OrganSystem ; rdfs:label "Metabolic / Endocrine System" .
organ:RespiratorySystem a organ:OrganSystem ; rdfs:label "Respiratory System" .
organ:NervousSystem a organ:OrganSystem ; rdfs:label "Nervous System" .
organ:HepatobiliarySystem a organ:OrganSystem ; rdfs:label "Hepatobiliary System" .
organ:MusculoskeletalSystem a organ:OrganSystem ; rdfs:label "Musculoskeletal System" .
organ:HematologicSystem a organ:OrganSystem ; rdfs:label "Hematologic System" .
organ:GastrointestinalSystem a organ:OrganSystem ; rdfs:label "Gastrointestinal System" .

# =============================================
# ~42 Common Conditions with Systemic Impact
# =============================================

bio:Type2Diabetes a bio:Condition ;
    rdfs:label "Type 2 Diabetes Mellitus" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:Kidney, organ:Heart, organ:BloodVessels, organ:Retina, organ:PeripheralNerves .

bio:Type1Diabetes a bio:Condition ;
    rdfs:label "Type 1 Diabetes Mellitus" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:Kidney, organ:Heart, organ:BloodVessels, organ:Retina, organ:PeripheralNerves .

bio:Hypertension a bio:Condition ;
    rdfs:label "Hypertension" ;
    impact:hasPrimaryImpactSystem organ:CardiovascularSystem ;
    impact:Impacts organ:Heart, organ:Kidney, organ:BloodVessels, organ:Brain .

bio:ChronicKidneyDisease a bio:Condition ;
    rdfs:label "Chronic Kidney Disease (CKD)" ;
    impact:hasPrimaryImpactSystem organ:RenalSystem ;
    impact:Impacts organ:Heart, organ:BloodVessels, organ:Bone .

bio:HeartFailure a bio:Condition ;
    rdfs:label "Heart Failure" ;
    impact:hasPrimaryImpactSystem organ:CardiovascularSystem ;
    impact:Impacts organ:Kidney, organ:Lung, organ:Liver .

bio:CoronaryArteryDisease a bio:Condition ;
    rdfs:label "Coronary Artery Disease" ;
    impact:hasPrimaryImpactSystem organ:CardiovascularSystem ;
    impact:Impacts organ:Heart, organ:BloodVessels .

bio:COPD a bio:Condition ;
    rdfs:label "Chronic Obstructive Pulmonary Disease (COPD)" ;
    impact:hasPrimaryImpactSystem organ:RespiratorySystem ;
    impact:Impacts organ:Heart, organ:BloodVessels .

bio:NAFLD a bio:Condition ;
    rdfs:label "Non-Alcoholic Fatty Liver Disease (NAFLD)" ;
    impact:hasPrimaryImpactSystem organ:HepatobiliarySystem ;
    impact:Impacts organ:Liver, organ:MetabolicSystem, organ:CardiovascularSystem .

bio:Obesity a bio:Condition ;
    rdfs:label "Obesity" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:Heart, organ:Kidney, organ:Liver, organ:Joints, organ:RespiratorySystem .

bio:Dyslipidemia a bio:Condition ;
    rdfs:label "Dyslipidemia" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:BloodVessels, organ:Heart .

bio:Hypothyroidism a bio:Condition ;
    rdfs:label "Hypothyroidism" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:Heart, organ:MetabolicSystem, organ:NervousSystem .

bio:RheumatoidArthritis a bio:Condition ;
    rdfs:label "Rheumatoid Arthritis" ;
    impact:hasPrimaryImpactSystem organ:MusculoskeletalSystem ;
    impact:Impacts organ:Joints, organ:Heart, organ:Lung, organ:BloodVessels .

bio:ObstructiveSleepApnea a bio:Condition ;
    rdfs:label "Obstructive Sleep Apnea" ;
    impact:hasPrimaryImpactSystem organ:RespiratorySystem ;
    impact:Impacts organ:Heart, organ:BloodVessels, organ:Brain .

bio:AtrialFibrillation a bio:Condition ;
    rdfs:label "Atrial Fibrillation" ;
    impact:hasPrimaryImpactSystem organ:CardiovascularSystem ;
    impact:Impacts organ:Heart, organ:Brain, organ:BloodVessels .

bio:PeripheralArteryDisease a bio:Condition ;
    rdfs:label "Peripheral Artery Disease" ;
    impact:hasPrimaryImpactSystem organ:CardiovascularSystem ;
    impact:Impacts organ:BloodVessels, organ:Legs, organ:Heart .

bio:Depression a bio:Condition ;
    rdfs:label "Major Depressive Disorder" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:CardiovascularSystem, organ:MetabolicSystem .

bio:ChronicPain a bio:Condition ;
    rdfs:label "Chronic Pain Syndrome" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:MusculoskeletalSystem, organ:MetabolicSystem .

bio:Osteoporosis a bio:Condition ;
    rdfs:label "Osteoporosis" ;
    impact:hasPrimaryImpactSystem organ:MusculoskeletalSystem ;
    impact:Impacts organ:Bone .

bio:Anemia a bio:Condition ;
    rdfs:label "Anemia" ;
    impact:hasPrimaryImpactSystem organ:HematologicSystem ;
    impact:Impacts organ:Heart, organ:Brain, organ:Kidney .

bio:Hyperlipidemia a bio:Condition ;
    rdfs:label "Hyperlipidemia" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:BloodVessels, organ:Heart .

# --- Expanded conditions ---

bio:Stroke a bio:Condition ;
    rdfs:label "Stroke / Cerebrovascular Disease" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:Heart, organ:BloodVessels .

bio:Asthma a bio:Condition ;
    rdfs:label "Asthma" ;
    impact:hasPrimaryImpactSystem organ:RespiratorySystem ;
    impact:Impacts organ:Lung, organ:Heart .

bio:Osteoarthritis a bio:Condition ;
    rdfs:label "Osteoarthritis" ;
    impact:hasPrimaryImpactSystem organ:MusculoskeletalSystem ;
    impact:Impacts organ:Joints, organ:MusculoskeletalSystem .

bio:Gout a bio:Condition ;
    rdfs:label "Gout" ;
    impact:hasPrimaryImpactSystem organ:MusculoskeletalSystem ;
    impact:Impacts organ:Joints, organ:Kidney .

bio:LiverCirrhosis a bio:Condition ;
    rdfs:label "Liver Cirrhosis" ;
    impact:hasPrimaryImpactSystem organ:HepatobiliarySystem ;
    impact:Impacts organ:Liver, organ:Kidney, organ:CardiovascularSystem .

bio:CrohnsDisease a bio:Condition ;
    rdfs:label "Crohn's Disease" ;
    impact:hasPrimaryImpactSystem organ:GastrointestinalSystem ;
    impact:Impacts organ:Intestine, organ:ImmuneSystem, organ:MusculoskeletalSystem .

bio:UlcerativeColitis a bio:Condition ;
    rdfs:label "Ulcerative Colitis" ;
    impact:hasPrimaryImpactSystem organ:GastrointestinalSystem ;
    impact:Impacts organ:Intestine, organ:ImmuneSystem .

bio:BreastCancer a bio:Condition ;
    rdfs:label "Breast Cancer" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:Breast, organ:ImmuneSystem, organ:Bone .

bio:ProstateCancer a bio:Condition ;
    rdfs:label "Prostate Cancer" ;
    impact:hasPrimaryImpactSystem organ:MetabolicSystem ;
    impact:Impacts organ:Prostate, organ:Bone, organ:UrinarySystem .

bio:ColorectalCancer a bio:Condition ;
    rdfs:label "Colorectal Cancer" ;
    impact:hasPrimaryImpactSystem organ:GastrointestinalSystem ;
    impact:Impacts organ:Intestine, organ:Liver, organ:ImmuneSystem .

bio:Dementia a bio:Condition ;
    rdfs:label "Dementia (incl. Alzheimer's)" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:CardiovascularSystem .

bio:ParkinsonsDisease a bio:Condition ;
    rdfs:label "Parkinson's Disease" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:MusculoskeletalSystem .

bio:MultipleSclerosis a bio:Condition ;
    rdfs:label "Multiple Sclerosis" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:SpinalCord, organ:ImmuneSystem .

bio:Psoriasis a bio:Condition ;
    rdfs:label "Psoriasis" ;
    impact:hasPrimaryImpactSystem organ:MusculoskeletalSystem ;
    impact:Impacts organ:Skin, organ:ImmuneSystem, organ:Joints .

bio:Fibromyalgia a bio:Condition ;
    rdfs:label "Fibromyalgia" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:MusculoskeletalSystem .

bio:PeripheralNeuropathy a bio:Condition ;
    rdfs:label "Peripheral Neuropathy" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:PeripheralNerves, organ:MusculoskeletalSystem .

bio:MacularDegeneration a bio:Condition ;
    rdfs:label "Age-related Macular Degeneration" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Retina, organ:Eye .

bio:HearingLoss a bio:Condition ;
    rdfs:label "Age-related Hearing Loss (Presbycusis)" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Ear, organ:NervousSystem .

bio:BenignProstaticHyperplasia a bio:Condition ;
    rdfs:label "Benign Prostatic Hyperplasia (BPH)" ;
    impact:hasPrimaryImpactSystem organ:UrinarySystem ;
    impact:Impacts organ:Prostate, organ:UrinarySystem .

bio:HIV a bio:Condition ;
    rdfs:label "HIV (Chronic Managed)" ;
    impact:hasPrimaryImpactSystem organ:ImmuneSystem ;
    impact:Impacts organ:ImmuneSystem, organ:CardiovascularSystem, organ:MetabolicSystem .

bio:ChronicFatigueSyndrome a bio:Condition ;
    rdfs:label "Chronic Fatigue Syndrome / ME" ;
    impact:hasPrimaryImpactSystem organ:NervousSystem ;
    impact:Impacts organ:Brain, organ:ImmuneSystem, organ:MetabolicSystem .

# =============================================
# Notes
# =============================================
# Expanded to ~42 conditions focused on systemic, diet-relevant,
# and polypharmacy-relevant conditions.
#
# Next steps possible:
# - Add diet interaction rules (separate rules.n3)
# - Add pharmacological interaction data
