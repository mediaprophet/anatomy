import "vibe:0.3/nquin" as nquin;
requires [capability("capability.invoke")];

let parity = nquin.wire.compute_wire_parity([72, 117, 109, 97, 110]);

// Human welfare suite. Geometry, measurements, and rule containers come from
// hypermedia.manifold.compile_vertebrate_anatomy_10d. This script lists the
// files. Synth's files producer writes the HMC.

let human_male = capability.invoke("hypermedia.manifold.compile_vertebrate_anatomy_10d", {
    profile: "male",
    title: "Human Welfare Anatomy — Adult Male",
    osteology_vis_01: 1.0,
    myology_vis_01: 0.92,
    integument_vis_01: 0.42,
    explode_01: 0.0
});
let human_male_skeleton = capability.invoke("hypermedia.manifold.compile_vertebrate_anatomy_10d", {
    profile: "male",
    title: "Human Welfare Anatomy — Adult Male Osteology",
    osteology_vis_01: 1.0,
    myology_vis_01: 0.0,
    integument_vis_01: 0.0,
    explode_01: 0.0
});
