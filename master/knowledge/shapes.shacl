@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

@prefix bio:   <https://qualia.anatomy.example/ontology/bio#> .
@prefix impact: <https://qualia.anatomy.example/ontology/impact#> .
@prefix organ: <https://qualia.anatomy.example/ontology/organ#> .

# =============================================
# SHACL Shapes for BioStatus Ontology & Ecosystem
# Version: 1.0 (Includes Epistemic Densitometry & Kinematic Shapes)
# =============================================

# --- Condition Shape ---
bio:ConditionShape a sh:NodeShape ;
    sh:targetClass bio:Condition ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Condition must have a human-readable label." ;
    ] ;
    sh:property [
        sh:path impact:hasPrimaryImpactSystem ;
        sh:minCount 1 ;
        sh:class organ:OrganSystem ;
        sh:message "Condition must declare at least one primary impact system." ;
    ] ;
    sh:property [
        sh:path impact:Impacts ;
        sh:minCount 1 ;
        sh:class organ:AnatomicalStructure ;
        sh:message "Condition must impact at least one anatomical structure or system." ;
    ] ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) .

# --- Impact Relationship Shape ---
impact:ImpactShape a sh:NodeShape ;
    sh:targetSubjectsOf impact:Impacts ;
    sh:property [
        sh:path impact:Impacts ;
        sh:minCount 1 ;
    ] .

# --- Severity Validation ---
impact:SeverityShape a sh:NodeShape ;
    sh:targetSubjectsOf impact:severity ;
    sh:property [
        sh:path impact:severity ;
        sh:in ( "Mild" "Moderate" "Severe" "Progressive" "Elevated" "High" ) ;
        sh:message "Severity must be one of: Mild, Moderate, Severe, Progressive, Elevated, High." ;
    ] .

# =============================================
# External Shape References (RadLex, DICOM, and Epistemic Densitometry)
# =============================================

# Reference to RadLex Anatomy SHACL shapes
# sh:include or graph imports via processor load of shapes/radlex-anatomy.shacl.ttl

# Reference to DICOM Healthcare SHACL shapes
# sh:include or graph imports via processor load of shapes/dicom-healthcare.shacl.ttl

# Reference to Epistemic Densitometry & Structural Kinematic SHACL shapes
# sh:include or graph imports via processor load of shapes/epistemic-densitometry.shacl.ttl

# =============================================
# Notes
# =============================================
# This file serves as the top-level SHACL validation entry point referencing:
# - radlex-anatomy.shacl.ttl
# - dicom-healthcare.shacl.ttl
# - epistemic-densitometry.shacl.ttl
